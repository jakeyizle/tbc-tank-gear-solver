{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.fast.config.ts" },
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "coverageAnalysis": "perTest",
  "concurrency": 8,
  "timeoutMS": 30000,
  "timeoutFactor": 2.5,
  "thresholds": { "high": 80, "low": 60 },
  "mutate": [
    "src/solver/**/*.ts",
    "src/sim/**/*.ts",
    "src/helpers/**/*.ts",
    "src/data/talentString.ts",
    "src/data/tbcDatabase.ts",
    "src/data/mechanics.ts",
    "src/types/SolverConfig.ts",
    "!src/**/*.test.ts",
    "!src/**/__fixtures__/**",
    "!src/**/__test-helpers__/**",
    "!src/sim/proto/**",
    "!src/sim/testFixtures/**",
    "!src/sim/protPaladinDefaultApl.ts",
    "!src/sim/protPaladinBaselineGear.ts",
    "!src/sim/protPaladinProfile.ts",
    "!src/sim/simExecutor.worker.ts",
    "!src/sim/deriveLinearModel.ts",
    "!src/sim/computeStatsClient.ts",
    "!src/sim/buildComputeStatsRequest.ts",
    "!src/sim/measureCharacterStats.ts",
    "!src/sim/fetchWasmModule.ts",
    "!src/sim/wasmCoordinator.ts",
    "!src/solver/types.ts",
    "!src/sim/statWeightsClient.ts",
    "!src/sim/simWorkerPool.ts"
  ],
  "ignorePatterns": [
    "dist",
    "coverage",
    "reports",
    ".stryker-tmp",
    "public/sim",
    "vendor/**",
    "!vendor/tbc-sim/assets/database/db.json",
    "!vendor/tbc-sim/ui/paladin/protection/gear_sets/p3.gear.json",
    "!vendor/tbc-sim/ui/core/talents/trees/paladin.json"
  ]
}
