{
  "name": "tbc-tank-gear-solver",
  "compatibility_date": "2026-08-30",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "analytics_engine_datasets": [
    { "binding": "TANK_SOLVER_ANALYTICS", "dataset": "tbc_tank_gear_solver_events" }
  ]
}
